# 依赖（本站实际零依赖，但这行留着防止将来有人 npm i 后手滑提交）
node_modules/

# ── 构建产物：**不入库** ──────────────────────────────────────
# dist/ 是 `npm run build` 的结果（页面里的 {{BRAND}} 占位符已落成真值、
# 测试文件已被挡在外面）。它在 CI 里每次重新生成，入库只会制造
# "仓库里的产物与源码不一致"这类只能靠人记得同步的坏状态。
dist/

# ── 环境变量：除模板外一律不入库 ──────────────────────────────
# 用 .env.* 而不是只写 .env：备份文件换个名字（.env.bak.xxx）就会绕过
# 只匹配 .env 的规则，而备份往往含真实密钥。
.env
.env.*
!.env.example

*.log
.DS_Store

# 临时物（拉代码/中间产物）
temp/
